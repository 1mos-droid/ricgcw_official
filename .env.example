# Paystack Public Key for RICGCW Online Giving (Client-side)
# Replace with your actual live public key (pk_live_...) in your production environment (.env)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_here

# Paystack Secret Key (Server-side ONLY - e.g. Vercel Environment Variables / Cloud Functions)
# NEVER expose this key in client-side code, .env, or git repositories.
# PAYSTACK_SECRET_KEY=sk_live_placeholder_secret_key_here
