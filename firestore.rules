rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'innercourtch@gmail.com' ||
        request.auth.token.email.matches('.*@ricgcw\\.me$')
      );
    }

    // Public church information, themes, and configuration (read-only for public, admin write)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public church content
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ministries/{ministryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsorshipProjects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Prayers: Anyone can submit a prayer request with required validation, but only admin can view or moderate
    match /prayers/{prayerId} {
      allow create: if request.resource.data.keys().hasAll(['request', 'createdAt'])
                    && request.resource.data.request is string
                    && request.resource.data.request.size() >= 3
                    && request.resource.data.request.size() <= 2000;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Contact Inquiries: Anyone can submit a contact message
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 3
                    && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Transactions: Financial gifts
    // Read and modify restricted strictly to church administration.
    // Creates restricted to valid transaction schemas with positive amounts.
    match /transactions/{transactionId} {
      allow create: if request.resource.data.keys().hasAll(['amount', 'currency', 'category', 'paymentReference', 'status'])
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.paymentReference is string
                    && request.resource.data.paymentReference.size() >= 5;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
